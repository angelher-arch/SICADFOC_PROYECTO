# =====================================================
# SICADFOC 2026 - Environment Variables Configuration
# PostgreSQL Database Connection Settings
# Copy this file to .env and update with your actual values
# =====================================================

# Environment Switching
# development = Base de datos local
# production  = Base de datos en la nube (Render)
APP_ENV=development

# Database Connection Parameters (Development - Local)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=db_foc26
DB_USER=postgres
DB_PASSWORD=admin123

# Production Database URL (Production - Cloud/Render)
# Formato: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://postgres:admin123@localhost:5432/db_foc26

# Connection Pool Settings
DB_MIN_CONNECTIONS=2
DB_MAX_CONNECTIONS=10
DB_TIMEOUT=30

# Application Settings
APP_DEBUG=true
APP_LOG_LEVEL=INFO

# Security Settings
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Streamlit Settings (if using Streamlit)
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=localhost
STREAMLIT_SERVER_HEADLESS=true

# File Upload Settings
MAX_FILE_SIZE_MB=10
UPLOAD_FOLDER=uploads

# Email Settings (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# Institution Settings
INSTITUTION_NAME=Instituto Universitario Jesus Obrero
INSTITUTION_EMAIL=info@sicadfoc.edu.ve
INSTITUTION_PHONE=+58-212-1234567
INSTITUTION_ADDRESS=Caracas, Venezuela

# Academic Year Settings
CURRENT_ACADEMIC_YEAR=2026
SEMESTER_COUNT=10
MIN_GRADE_TO_APPROVE=15.00

# Backup Settings
BACKUP_ENABLED=true
BACKUP_SCHEDULE=daily
BACKUP_RETENTION_DAYS=30
